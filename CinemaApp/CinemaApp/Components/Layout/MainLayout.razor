@inherits LayoutComponentBase
<nav class="navbar">
    <ul class="navbar-left">
        <li><NavLink href="" Match="NavLinkMatch.All" class="navlink-left">Cinemanova</NavLink></li>
    </ul>
    <ul class="navbar-right">
        <AuthorizeView Roles="User">
            <Authorized>
                <li><NavLink href="films" class="navlink-right">Film</NavLink></li>
                <li><NavLink href="program" class="navlink-right">Programma</NavLink></li>
                <li><NavLink href="tickets" class="navlink-right">Biglietti</NavLink></li>
                <li><NavLink href="about" class="navlink-right">About</NavLink></li>
                <li><NavLink href="contacts" class="navlink-right">Contatti</NavLink></li>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <NotAuthorized>
                <li><NavLink href="films" class="navlink-right">Film</NavLink></li>
                <li><NavLink href="program" class="navlink-right">Programma</NavLink></li>
                <li><NavLink href="tickets" class="navlink-right">Biglietti</NavLink></li>
                <li><NavLink href="about" class="navlink-right">About</NavLink></li>
                <li><NavLink href="contacts" class="navlink-right">Contatti</NavLink></li>
            </NotAuthorized>
        </AuthorizeView>
        <AuthorizeView>
            <NotAuthorized>
                <li><NavLink href="login" class="navlink-right">Login</NavLink></li>
            </NotAuthorized>
        </AuthorizeView>
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <li><NavLink href="admin/manage-films" class="navlink-right">Gestisci Film</NavLink></li>
                <li><NavLink href="admin/manage-projections" class="navlink-right">Gestisci Proiezioni</NavLink></li>
                <li><NavLink href="admin/manage-accounts" class="navlink-right">Gestisci Accounts</NavLink></li>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <li><NavLink href="logout/confirm-logout" class="navlink-right">Logout</NavLink></li>
            </Authorized>
        </AuthorizeView>
    </ul>
</nav>

<main>
    <article>
        @Body
    </article>
</main>

<footer> &copy; 2025 Cinema CinemaNova - Tutti i diritti riservati </footer>

<div id="blazor-error-ui" images-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>