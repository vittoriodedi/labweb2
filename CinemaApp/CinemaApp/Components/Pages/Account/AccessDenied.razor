@page "/access-denied"

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h1 class="login-title">Accesso Negato</h1>
            <p class="login-subtitle">Non hai i permessi necessari</p>
        </div>
        
        <p class="logout-message">
            Se ritieni che si tratti di un errore, contatta l'amministratore di sistema.
        </p>
        
        <div class="action-buttons">
            <a href="/" class="btn-primary">Torna alla Home</a>
        </div>
    </div>
</div>