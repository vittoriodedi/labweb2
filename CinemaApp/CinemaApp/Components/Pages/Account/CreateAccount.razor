@page "/create-account"

@using CinemaApp.Models
@using CinemaApp.Models.Entities
@using CinemaApp.Models.ViewModels
@inject CinemaDbContext DbContext
@inject NavigationManager NavigationManager

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h1 class="login-title">Registrazione</h1>
            <p class="login-subtitle">Crea un nuovo account <br/> Inserisci le tue informazioni qui sotto.</p>
        </div>
        
        <EditForm Model="@Model" OnValidSubmit="CreateUserAccount" FormName="RegisterForm">
            <DataAnnotationsValidator />
            
            <div class="form-group">
                <label class="form-label">Email</label>
                <InputText @bind-Value="Model.Email" class="form-control" placeholder="Inserisci la tua email" />
                <div class="validation-message">
                    <ValidationMessage For="() => Model.Email" />
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label">Nome Utente</label>
                <InputText @bind-Value="Model.UserName" class="form-control" placeholder="Inserisci il tuo nome utente" />
                <div class="validation-message">
                    <ValidationMessage For="() => Model.UserName" />
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label">Password</label>
                <InputText @bind-Value="Model.Password" class="form-control" type="password" placeholder="Inserisci la tua password" />
                <div class="validation-message">
                    <ValidationMessage For="() => Model.Password" />
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label">Conferma Password</label>
                <InputText @bind-Value="Model.ConfirmPassword" class="form-control" type="password" placeholder="Conferma la tua password" />
                <div class="validation-message">
                    <ValidationMessage For="() => Model.ConfirmPassword" />
                </div>
            </div>

            <div class="error-message">
                @errorMessage
            </div>
            
            <button type="submit" class="btn-login">Registrati</button>
            
            <div class="register-link">
                Hai già un account? <a href="/login">Accedi</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm] 
    public RegisterViewModel Model { get; set; } = new();

    private string? errorMessage;
    
    private async Task CreateUserAccount()
    {
        // Verifica se l'utente esiste già
        var existingUser = DbContext.UserAccounts.FirstOrDefault(x => x.UserName == Model.UserName);
        if (existingUser != null)
        {
            errorMessage = "Nome utente già in uso";
            return;
        }

        // Verifica se le password corrispondono
        if (Model.Password != Model.ConfirmPassword)
        {
            errorMessage = "Le password non corrispondono";
            return;
        }

        // Creazione del nuovo account utente
        var newUser = new UserAccount
        {
            UserName = Model.UserName,
            Password = Model.Password,
            Email = Model.Email,
            Role = "User" // Ruolo predefinito per i nuovi utenti
        };

        DbContext.UserAccounts.Add(newUser);
        await DbContext.SaveChangesAsync();
        
        // Reindirizza alla pagina di login
        NavigationManager.NavigateTo("/login");
    }
}