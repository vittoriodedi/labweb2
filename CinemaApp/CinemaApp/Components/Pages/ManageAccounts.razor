@page "/manage-accounts"
@using CinemaApp.Models
@using CinemaApp.Models.Entities
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>Gestisci Account - CinemaNova</PageTitle>


<div class="layout-wrapper">
    @if (users == null || users.Count == 0)
    {
        <MudText Typo="Typo.h5" Class="mb-4">Lista Utenti non presente</MudText>
    }
    else
    {
        <div class="container content">
            <div class="header">
                <h1>Gestione Account</h1>
                <p>Visualizza e gestisci tutti gli account utente nel database</p>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Ruolo</th>
                        <th>Azioni</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td><span class="user-name">@user.UserName</span></td>
                            <td>@user.Email</td>
                            <td><span class="badge badge-admin">@user.Role</span></td>
                            <td><button class="btn btn-delete" @onclick="() => DeleteUser(user)">Elimina</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>


@inject CinemaDbContext dbContext
@code {
    private List<UserAccount> users = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await dbContext.UserAccounts.ToListAsync();
    }

    private async Task DeleteUser(UserAccount user)
    {
        dbContext.UserAccounts.Remove(user);
        await dbContext.SaveChangesAsync();
        await LoadUsers();
    }
}