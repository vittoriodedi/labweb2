@page "/admin/manage-films/insert-film"
@rendermode InteractiveServer
@inject IConfiguration Configuration
@inject HttpClient Http
@inject NavigationManager Navigation
@inject CinemaDbContext dbContext
@* @attribute [Authorize(Roles = "Administrator")] *@

<PageTitle>Gestione Films</PageTitle>

<div class="layout-wrapper">
    <div class="content">

        <div class="search-container">
            <h1>Cerca Film</h1>
            <div class="search-bar">
                <input type="text" @bind="filmTitle" placeholder="Titolo del film" />
                <button @onclick="Cerca">Cerca</button>
            </div>
        </div>

        @if (movies?.Any() == true)
        {
            <p>Risultati trovati per <strong>@savedTitle</strong>:</p>

            <div class="card-container">
                @foreach (var movie in movies)
                {
                    <div class="card-wrapper">
                        <div class="card h-100 shadow-sm">
                            @if (@movie.poster_path == null)
                            {
                                <img src="images/default_poster.png"
                                     class="card-img-top"
                                     loading="lazy"
                                     alt="Poster film"/>
                            }
                            else
                            {
                                <img src="@($"https://image.tmdb.org/t/p/original{movie.poster_path}")"
                                     class="card-img-top"
                                     loading="lazy"
                                     alt="Poster film"/>
                            }

                            <div class="card-body">
                                <h5 class="card-title">@movie.original_title (@movie.original_language)</h5>
                                <h5 class="card-title">Uscita: @movie.release_date</h5>
                            </div>

                            <div class="card-footer">
                                <button class="btn btn-primary" @onclick="() => OpenEditDialog(movie)">
                                    <span class="oi oi-plus me-1"></span> Aggiungi al catalogo
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (savedTitle != string.Empty)
        {
            <p>Nessun risultato trovato per <strong>@savedTitle</strong>.</p>
        }

    </div>
</div>

@if (editDialogVisible && filmToEdit != null)
{
    <div class="dialog-overlay">
        <div class="edit-dialog">
            <h2>Aggiungi Film al Catalogo</h2>

            <div class="form-group">
                <label for="titolo">Titolo:</label>
                <input type="text" id="titolo" @bind="filmToEdit.Titolo" required />
            </div>

            <div class="form-group">
                <label for="dataUscita">Data di Uscita:</label>
                <input type="date" id="dataUscita" @bind="filmToEdit.DataUscita" required />
            </div>

            <div class="form-group">
                <label for="genere">Genere:</label>
                <input type="text" id="genere" @bind="filmToEdit.Genere" required />
            </div>

            <div class="form-group">
                <label for="regista">Regista:</label>
                <input type="text" id="regista" @bind="filmToEdit.Regista" required />
            </div>

            <div class="form-group">
                <label for="durata">Durata (minuti):</label>
                <input type="number" id="durata" @bind="filmToEdit.DurataMinuti" required />
            </div>

            <div class="form-group">
                <label for="trama">Trama:</label>
                <textarea id="trama" @bind="filmToEdit.Trama" rows="4" required></textarea>
            </div>

            <div class="form-group">
                <label for="locandina">URL Locandina:</label>
                <input type="text" id="locandina" @bind="filmToEdit.LocandinaUrl" required />
            </div>

            <div class="form-group">
                <label for="adulti">Contenuto per Adulti:</label>
                <input type="checkbox" id="adulti" @bind="filmToEdit.Adulti" />
            </div>

            <div class="form-group">
                <label for="valutazione">Valutazione:</label>
                <MudRating @bind-SelectedValue="filmToEdit.Valutazione" MaxValue="5" />
            </div>

            <div class="button-group">
                <button class="btn btn-primary" @onclick="SaveChanges">Salva</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Annulla</button>
            </div>
        </div>
    </div>
}

@code {
    private Film filmToEdit;
    private bool editDialogVisible = false;


    private string filmTitle = string.Empty;
    private string savedTitle = string.Empty;
    private List<Movie> movies = new();
    private async Task Cerca()
    {
        savedTitle = filmTitle;
        filmTitle = string.Empty;

        var apiKey = Configuration["TMDb:ApiKey"];
        var language = "it-IT";
        var url = $"https://api.themoviedb.org/3/search/movie?api_key={apiKey}&language={language}&query={Uri.EscapeDataString(savedTitle)}";

        try
        {
            var response = await Http.GetFromJsonAsync<RootResponse>(url);
            movies = response?.results ?? new List<Movie>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore nella chiamata API: {ex.Message}");
            movies = new List<Movie>();
        }
    }
    public class RootResponse
    {
        public List<Movie> results { get; set; }
    }
    public class Movie
    {
        public bool adult { get; set; }
        public string original_title { get; set; }
        public string original_language { get; set; }
        public string poster_path { get; set; }
        public string release_date { get; set; }
        public int[] genre_ids { get; set; }
        public string overview { get; set; }
        public string title { get; set; }
        public double vote_average { get; set; }

    }
    private static readonly Dictionary<int, string> GenreMap = new Dictionary<int, string>
    {
        { 28, "Azione" },
        { 12, "Avventura" },
        { 16, "Animazione" },
        { 35, "Commedia" },
        { 80, "Crime" },
        { 99, "Documentario" },
        { 18, "Drammatico" },
        { 10751, "Famiglia" },
        { 14, "Fantasy" },
        { 36, "Storico" },
        { 27, "Horror" },
        { 10402, "Musica" },
        { 9648, "Mistero" },
        { 10749, "Romantico" },
        { 878, "Fantascienza" },
        { 10770, "Film TV" },
        { 53, "Thriller" },
        { 10752, "Guerra" },
        { 37, "Western" }
    };


    private Film ConvertMovieToFilm(Movie selectedMovie)
    {
        string generi = "";
        if (selectedMovie.genre_ids != null && selectedMovie.genre_ids.Length > 0)
        {
            var genreNames = selectedMovie.genre_ids
                .Where(id => GenreMap.ContainsKey(id))
                .Select(id => GenreMap[id])
                .Take(3);
    
            generi = string.Join(", ", genreNames);
        }

        int valutazione = 0;
        if (selectedMovie.vote_average > 0)
        {
            valutazione = (int)Math.Round(selectedMovie.vote_average / 2);
            
            valutazione = Math.Max(1, Math.Min(5, valutazione));
        }

        return new Film
        {
            Titolo = selectedMovie.title,
            DataUscita = selectedMovie.release_date != null 
                ? DateOnly.FromDateTime(DateTime.Parse(selectedMovie.release_date)) 
                : DateOnly.FromDateTime(DateTime.Now),
            LocandinaUrl = selectedMovie.poster_path,
            Adulti = selectedMovie.adult,
            Genere = generi,
            Regista = "", 
            DurataMinuti = 0,
            Trama = selectedMovie.overview ?? "",
            Valutazione = valutazione
        };
    }

    private void OpenEditDialog(Movie selectedMovie)
    {
        filmToEdit = ConvertMovieToFilm(selectedMovie);
        editDialogVisible = true;
        StateHasChanged();
    }

    private async Task SaveChanges()
    {
        if (filmToEdit != null)
        {
            dbContext.Films.Add(filmToEdit);
            await dbContext.SaveChangesAsync();
            editDialogVisible = false;
            Navigation.NavigateTo("/manage-films");
        }
    }


    private void CancelEdit()
    {
        editDialogVisible = false;
    }

}

