@page "/admin/manage-projections"
@inject CinemaDbContext DbContext
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator, Employee")]

<PageTitle>Gestione Proiezioni - CinemaNova Admin</PageTitle>
<div class="layout-wrapper">
    <div class="container content">
        <div class="header">
            <h1>Gestione Proiezioni</h1>
            <p>Crea e gestisci le proiezioni dei film nelle sale</p>
        </div>
        <div class="action-bar">
            <button class="btn btn-primary" @onclick="ShowCreationForm">Nuova Proiezione</button>
        </div>
        <div class="table-wrapper @(proiezioni == null || !proiezioni.Any() ? "no-shadow" : "")">
            @if (proiezioni != null && proiezioni.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Film</th>
                            <th>Sala</th>
                            <th>Data e Ora</th>
                            <th>Prezzo Base</th>
                            <th>Biglietti Venduti</th>
                            <th>Stato</th>
                            <th>Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var proiezione in proiezioni.OrderBy(p => p.DataOra))
                    {
                        <tr>
                            <td>@proiezione.Film.Titolo</td>
                            <td>@proiezione.Sala.Nome</td>
                            <td>@proiezione.DataOra.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>€@proiezione.PrezzoBase</td>
                            <td>@proiezione.Biglietti.Count / @proiezione.Sala.CapacitaPosti</td>
                            <td>
                                @if (proiezione.Attiva)
                                {
                                    <span class="badge badge-active">Attiva</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">Disattivata</span>
                                }
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <button class="btn btn-edit" @onclick="() => ModifyProjection(proiezione.Id)" title="Modifica">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 24 24">
                                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" transform="scale(1.5)"/>
                                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" transform="scale(1.5)"/>
                                        </svg>
                                    </button>
                                    <button class="btn @(proiezione.Attiva ? "btn-deactivate" : "btn-activate")"
                                            @onclick="() => ToggleProjectionState(proiezione)"
                                            title="@(proiezione.Attiva ? "Disattiva" : "Attiva")">
                                        @if (proiezione.Attiva)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-toggle-on" viewBox="0 0 16 16">
                                                <path d="M5 3a5 5 0 0 0 0 10h6a5 5 0 0 0 0-10zm6 9a4 4 0 1 1 0-8 4 4 0 0 1 0 8"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-toggle-off" viewBox="0 0 16 16">
                                                <path d="M11 4a4 4 0 0 1 0 8H8a5 5 0 0 0 2-4 5 5 0 0 0-2-4zm-6 8a4 4 0 1 1 0-8 4 4 0 0 1 0 8M0 8a5 5 0 0 0 5 5h6a5 5 0 0 0 0-10H5a5 5 0 0 0-5 5"/>
                                            </svg>
                                        }
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <div class="error-container">
                    <p>Nessuna proiezione disponibile al momento</p><br/>
                    <p>Aggiungine una!</p>
                </div>
            }
        </div>
    </div>
</div>

@if (showInsertDialog)
    {
        <div class="dialog-overlay" @onclick="CloseDialog">
            <div class="edit-dialog" @onclick:stopPropagation="true">
                <h2>@(proiezioneSelezionata.Id == 0 ? "Nuova Proiezione" : "Modifica Proiezione")</h2>

                @if (errorMessage != null)
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                <div class="form-group">
                    <label>Film</label>
                    <select @bind="proiezioneSelezionata.FilmId" class="form-control">
                        <option value="0">-- Seleziona Film --</option>
                        @if (films != null)
                        {
                            @foreach (var film in films)
                            {
                                <option value="@film.Id">@film.Titolo</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Sala</label>
                    <select @bind="proiezioneSelezionata.SalaId" class="form-control">
                        <option value="0">-- Seleziona Sala --</option>
                        @if (sale != null)
                        {
                            @foreach (var sala in sale)
                            {
                                <option value="@sala.Id">@sala.Nome</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Data e Ora</label>
                    <input type="datetime-local" @bind="proiezioneSelezionata.DataOra" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Prezzo Base (€)</label>
                    <input type="number" step="0.50" min="0" @bind="proiezioneSelezionata.PrezzoBase" class="form-control" />
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" @bind="proiezioneSelezionata.Attiva" />
                        Proiezione attiva
                    </label>
                </div>

                <div class="button-group">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Annulla</button>
                    <button class="btn btn-primary" @onclick="SaveProjections">Salva</button>
                </div>
            </div>
        </div>
    }

@code {
    private bool showInsertDialog;
    private string errorMessage;
    private dynamic elementToDelete; 
    private List<Sala>? sale;
    private List<Film>? films;
    private List<Proiezione>? proiezioni;

    
    private Proiezione proiezioneSelezionata = new Proiezione {
        DataOra = DateTime.Now.AddHours(1).Date.AddHours(20),
        PrezzoBase = 9.00m,
        Attiva = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            films = await DbContext.Films.ToListAsync();
            sale = await DbContext.Sale.ToListAsync();

            proiezioni = await DbContext.Proiezioni
                .Include(p => p.Film)
                .Include(p => p.Sala)
                .Include(p => p.Biglietti)
                .OrderBy(p => p.DataOra)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore nel caricamento dei dati: {ex.Message}";
        }
    }

    private void ShowCreationForm()
    {
        proiezioneSelezionata = new Proiezione
        {
            DataOra = DateTime.Now.AddHours(1).Date.AddHours(20),
            PrezzoBase = 9.00m,
            Attiva = true
        };
        errorMessage = null;
        showInsertDialog = true;
    }

    private async Task ModifyProjection(int id)
    {
        try
        {
            var proiezione = await DbContext.Proiezioni.FindAsync(id);
            if (proiezione != null)
            {
                proiezioneSelezionata = proiezione;
                errorMessage = null;
                showInsertDialog = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore nel recupero della proiezione: {ex.Message}";
        }
    }

    private void CloseDialog()
    {
        showInsertDialog = false;
        errorMessage = null;
    }
    
    private async Task ToggleProjectionState(Proiezione proiezione)
    {
        try
        {
            proiezione.Attiva = !proiezione.Attiva;
            await DbContext.SaveChangesAsync();
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore nella modifica dello stato: {ex.Message}";
        }
    }

    private async Task SaveProjections()
    {
        errorMessage = null;

        try
        {
            if (proiezioneSelezionata.FilmId <= 0)
            {
                errorMessage = "Seleziona un film per la proiezione";
                return;
            }

            if (proiezioneSelezionata.SalaId <= 0)
            {
                errorMessage = "Seleziona una sala per la proiezione";
                return;
            }

            if (proiezioneSelezionata.DataOra < DateTime.Now)
            {
                errorMessage = "Non è possibile creare proiezioni nel passato";
                return;
            }

            if (proiezioneSelezionata.PrezzoBase <= 0)
            {
                errorMessage = "Il prezzo base deve essere maggiore di zero";
                return;
            }

            var filmDurata = await DbContext.Films
                .Where(f => f.Id == proiezioneSelezionata.FilmId)
                .Select(f => f.DurataMinuti)
                .FirstOrDefaultAsync();

            if (filmDurata <= 0)
            {
                errorMessage = "Errore: la durata del film non è valida";
                return;
            }

            var dataFineProiezione = proiezioneSelezionata.DataOra.AddMinutes(filmDurata);

            var sovrapposizioni = await DbContext.Proiezioni
                .Where(p => p.Id != proiezioneSelezionata.Id && p.SalaId == proiezioneSelezionata.SalaId)
                .Where(p =>
                    (p.DataOra <= proiezioneSelezionata.DataOra && p.DataOra.AddMinutes(p.Film.DurataMinuti) > proiezioneSelezionata.DataOra) ||
                    (p.DataOra >= proiezioneSelezionata.DataOra && p.DataOra < dataFineProiezione)
                )
                .Include(p => p.Film)
                .ToListAsync();

            if (sovrapposizioni.Any())
            {
                var sovrapposizione = sovrapposizioni.First();
                errorMessage = $"C'è una sovrapposizione con la proiezione di '{sovrapposizione.Film.Titolo}' programmata alle {sovrapposizione.DataOra.ToString("HH:mm")}";
                return;
            }

            if (proiezioneSelezionata.Id == 0)
            {
                DbContext.Proiezioni.Add(proiezioneSelezionata);
            }
            else
            {
                DbContext.Proiezioni.Update(proiezioneSelezionata);
            }

            await DbContext.SaveChangesAsync();
            await LoadData();
            showInsertDialog = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore nel salvataggio della proiezione: {ex.Message}";
        }
    }
}