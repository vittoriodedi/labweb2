@page "/admin/manage-films"
@inject CinemaDbContext DbContext
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>Gestisci Account - CinemaNova</PageTitle>

@if (films == null || films.Count == 0)
{
    <div class="error-container">
        <p>Nessun Film presente.</p>
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-three-dots" viewBox="0 0 16 16">
            <path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3"/>
        </svg>
    </div>    
}
else
{
    <div class="layout-wrapper">
        <div class="container content">
            <div class="header">
                <h1>Gestione Film</h1>
                <p>Visualizza e gestisci tutti i film presenti nel database</p>
            </div>
            
            <div class="action-bar">
                <button class="btn btn-primary" @onclick="() => GoToCreateFilm()">
                    Nuovo Film
                </button>
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Titolo</th>
                            <th>Data di Uscita</th>
                            <th>Genere</th>
                            <th>Regista</th>
                            <th>Durata</th>
                            <th>Adulti</th>
                            <th>Valutazione</th>
                            <th>Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var film in films)
                    {
                        <tr>
                            <td><span class="user-name">@film.Titolo</span></td>
                            <td>@film.DataUscita</td>
                            <td><span class="badge badge-admin">@film.Genere</span></td>
                            <td>@film.Regista</td>
                            <td>@film.DurataMinuti min</td>
                            <td>@(film.Adulti ? "Si" : "No")</td>
                            <td><MudRating ReadOnly="true" SelectedValue="@film.Valutazione"/></td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <button class="btn btn-edit" @onclick="() => ModifyFilm(film)" title="Modifica">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 24 24">
                                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" transform="scale(1.5)"/>
                                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" transform="scale(1.5)"/>
                                        </svg>
                                    </button>
                                    <button class="btn btn-delete" @onclick="() => DeleteFilm(film)" title="Elimina">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-trash" viewBox="0 0 24 24">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" transform="scale(1.5)"/>
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" transform="scale(1.5)"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (showEditDialog && filmToEdit != null)
{
    <div class="dialog-overlay">
        <div class="edit-dialog">
            <h2>Modifica Film</h2>
            
            <div class="form-group">
                <label for="titolo">Titolo:</label>
                <input type="text" id="titolo" @bind="filmToEdit.Titolo" required />
            </div>
            
            <div class="form-group">
                <label for="dataUscita">Data di Uscita:</label>
                <input type="date" id="dataUscita" @bind="filmToEdit.DataUscita" required />
            </div>
            
            <div class="form-group">
                <label for="genere">Genere:</label>
                <input type="text" id="genere" @bind="filmToEdit.Genere" required />
            </div>
            
            <div class="form-group">
                <label for="regista">Regista:</label>
                <input type="text" id="regista" @bind="filmToEdit.Regista" required />
            </div>
            
            <div class="form-group">
                <label for="durata">Durata (minuti):</label>
                <input type="number" id="durata" @bind="filmToEdit.DurataMinuti" required />
            </div>
            
            <div class="form-group">
                <label for="trama">Trama:</label>
                <textarea id="trama" @bind="filmToEdit.Trama" rows="4" required></textarea>
            </div>
            
            <div class="form-group">
                <label for="locandina">URL Locandina:</label>
                <input type="text" id="locandina" @bind="filmToEdit.LocandinaUrl" required />
            </div>
            
            <div class="form-group">
                <label for="adulti">Contenuto per Adulti:</label>
                <input type="checkbox" id="adulti" @bind="filmToEdit.Adulti" />
            </div>
            
            <div class="form-group">
                <label for="valutazione">Valutazione:</label>
                <MudRating @bind-SelectedValue="filmToEdit.Valutazione" MaxValue="5" />
            </div>
            
            <div class="button-group">
                <button class="btn btn-primary" @onclick="SaveChanges">Salva</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Annulla</button>
            </div>
        </div>
    </div>
}

@if (showDeleteDialog)
{
    <div class="dialog-overlay" @onclick="CloseDeleteDialog">
        <div class="edit-dialog" @onclick:stopPropagation="true">
            <h2>Conferma Eliminazione</h2>

            <p>Sei sicuro di voler eliminare il film "@(filmToDelete?.Titolo)"?</p>
            <p>Questa azione non può essere annullata.</p>

            <div class="button-group">
                <button class="btn btn-secondary" @onclick="CloseDeleteDialog">Annulla</button>
                <button class="btn btn-delete" @onclick="ConfirmDelete">Elimina</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Film> films = new();
    
    private Film filmToEdit;
    private Film filmToDelete;
    private bool showEditDialog;
    private bool showDeleteDialog;

    protected override async Task OnInitializedAsync()
    {
        await LoadFilms();
    }

    private async Task LoadFilms()
    {
        films = await DbContext.Films.ToListAsync();
    }
    
    private void GoToCreateFilm()
    {
        Navigation.NavigateTo($"/admin/manage-films/insert-film");
    }
    
    private async Task ModifyFilm(Film film)
    {
        filmToEdit = film;
        showEditDialog = true;
        StateHasChanged();
    }
    
    private async Task SaveChanges()
    {
        if (filmToEdit != null)
        {
            DbContext.Films.Update(filmToEdit);
            await DbContext.SaveChangesAsync();
            await LoadFilms();
            showEditDialog = false;
        }
    }
    
    private void CancelEdit()
    {
        showEditDialog = false;
    }

    private void DeleteFilm(Film film)
    {
        filmToDelete = film;
        showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        filmToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (filmToDelete != null)
        {
            DbContext.Films.Remove(filmToDelete);
            await DbContext.SaveChangesAsync();
            await LoadFilms();
        }
        CloseDeleteDialog();
    }
    
}