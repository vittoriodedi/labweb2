@page "/admin/manage-accounts"
@inject CinemaDbContext DbContext
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator, Employee")]

<PageTitle>Gestisci Account - CinemaNova</PageTitle>

<div class="layout-wrapper">
    <div class="container content">
        <div class="header">
            <h1>Gestione Account</h1>
            
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <p>Visualizza e gestisci tutti gli account Impiegati presenti nel sistema</p>
                </Authorized>
            </AuthorizeView>
            
            <AuthorizeView Roles="Employee">
                <Authorized>
                    <p>Visualizza e gestisci tutti gli account Utenti presenti nel sistema</p>
                </Authorized>
            </AuthorizeView>
        </div>
        
        <div class="action-bar">
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <button class="btn-confirm" @onclick="ShowCreationForm">Nuovo Dipendente</button>
                </Authorized>
            </AuthorizeView>
            
            <AuthorizeView Roles="Employee">
                <Authorized>
                    <button class="btn-confirm" @onclick="ShowCreationForm">Nuovo Utente</button>
                </Authorized>
            </AuthorizeView>
        </div>
        
        @if (accounts == null || accounts.Count == 0)
        {
            <div class="error-container">
                <p>Nessun Account presente.</p>
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-three-dots" viewBox="0 0 16 16">
                    <path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3"/>
                </svg>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                    <tr>
                        <th class="first-th">Username</th>
                        <th>Email</th>
                        <th>Azioni</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var account in accounts)
                    {
                        <tr>
                            <td class="first-td">@account.UserName</td>
                            <td>@account.Email</td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <button class="btn-delete" @onclick="() => DeleteAccount(account)" title="Elimina">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (showEditDialog)
{
    <div class="dialog-overlay" @onclick="CloseEditDialog">
        <div class="edit-dialog" @onclick:stopPropagation="true">
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <h2>Nuovo Impiegato</h2>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Employee">
                <Authorized>
                    <h2>Nuovo Utente</h2>
                </Authorized>
            </AuthorizeView>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            <EditForm Model="registerModel" OnValidSubmit="SalvaAccount">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="username">Username:</label>
                    <InputText id="username" @bind-Value="registerModel.UserName" class="form-control" />
                    <ValidationMessage For="@(() => registerModel.UserName)" />
                </div>
                
                <div class="form-group">
                    <label for="email">Email:</label>
                    <InputText id="email" @bind-Value="registerModel.Email" class="form-control" />
                    <ValidationMessage For="@(() => registerModel.Email)" />
                </div>
                
                <div class="form-group">
                    <label for="password">Password:</label>
                    <InputText type="password" id="password" @bind-Value="registerModel.Password" class="form-control" />
                    <ValidationMessage For="@(() => registerModel.Password)" />
                </div>
                
                <div class="form-group">
                    <label for="confirmPassword">Conferma Password:</label>
                    <InputText type="password" id="confirmPassword" @bind-Value="registerModel.ConfirmPassword" class="form-control" />
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                </div>

                <div class="button-group">
                    <button type="button" class="btn-cancel" @onclick="CloseEditDialog">Annulla</button>
                    <button type="submit" class="btn-confirm">Salva</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showDeleteDialog)
{
    <div class="dialog-overlay" @onclick="CloseDeleteDialog">
        <div class="edit-dialog" @onclick:stopPropagation="true">
            <h2>Conferma Eliminazione</h2>
            
            <p>Sei sicuro di voler eliminare questo elemento?</p>
            <p>Questa azione non può essere annullata.</p>
            
            <div class="button-group">
                <button class="btn-cancel" @onclick="CloseDeleteDialog">Annulla</button>
                <button class="btn-delete" @onclick="ConfirmDelete">Elimina</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showEditDialog;
    private string errorMessage;
    private bool showDeleteDialog;
    private List<UserAccount> accounts = new();
    private RegisterAdminViewModel registerModel = new();
    private UserAccount accountToDelete;
    private string currentRole;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var user = authState.User;
        
        if (user.IsInRole("Administrator"))
        {
            currentRole = "Employee";
        }
        else if (user.IsInRole("Employee"))
        {
            currentRole = "User";
        }
        
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        accounts = await DbContext.UserAccounts.Where(u => u.Role == currentRole).ToListAsync();
    }
    
    private void ShowCreationForm()
    {
        registerModel = new RegisterAdminViewModel();
        errorMessage = null;
        showEditDialog = true;
    }
    
    private void CloseEditDialog()
    {
        showEditDialog = false;
        errorMessage = null;
    }
    
    private async Task SalvaAccount()
    {
        errorMessage = null;
        
        try
        {
            var existingUser = await DbContext.UserAccounts
                .FirstOrDefaultAsync(u => u.UserName == registerModel.UserName || u.Email == registerModel.Email);
                
            if (existingUser != null)
            {
                errorMessage = "Username o email già in uso";
                return;
            }
            
            var nuovoAccount = new UserAccount
            {
                UserName = registerModel.UserName,
                Email = registerModel.Email,
                Password = registerModel.Password,
                Role = currentRole
            };
            
            DbContext.UserAccounts.Add(nuovoAccount);
            await DbContext.SaveChangesAsync();
            await LoadUsers();
            showEditDialog = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore nella creazione dell'account: {ex.Message}";
        }
    }
    
    private void DeleteAccount(UserAccount Account)
    {
        accountToDelete = Account;
        showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        accountToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (accountToDelete != null)
        {
            DbContext.UserAccounts.Remove(accountToDelete);
            await DbContext.SaveChangesAsync();
            await LoadUsers();
        }
        CloseDeleteDialog();
    }
}